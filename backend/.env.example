# Copy this file to ".env" (same folder) and fill in your own values.
# The .env file is YOURS — it stays on your computer, is never committed to git,
# and is never sent anywhere. Never paste these values into a chat.

# --- Data source: "csv" (offline, default) or "angelone" (live broker feed) ---
DATA_PROVIDER=csv

# --- Angel One SmartAPI (only needed when DATA_PROVIDER=angelone) ---
# Get these from https://smartapi.angelone.in (create an app + enable TOTP).
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# --- Market-data feed: "none" (off) or "angel". DATA ONLY (instrument list, lot
# sizes, live prices) — never reads holdings. Uses the Angel creds above. ---
MARKET_DATA=none

# --- AI explainer: "none" (off) | "gemini" (free) | "claude" (paid) ---
AI_PROVIDER=gemini

# --- Google Gemini (FREE tier; get a key at https://aistudio.google.com) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Claude / Anthropic (paid; get a key at https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Advanced (usually leave as-is) ---
# DATABASE_URL=sqlite:///./data/risk.db
# FRONTEND_ORIGIN=http://localhost:5173
